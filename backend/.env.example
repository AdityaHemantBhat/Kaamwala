NODE_ENV="development" # REQUIRED: "development" | "test" | "production" — app refuses to boot otherwise
ENABLE_DEV_BACKDOORS="false" # "true" turns on fixed OTPs (123456/1234), OTP logging and mock payments — MUST be false in production
PORT="5000"
DATABASE_URL="postgresql://user:password@localhost:5432/kaamwala?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT — RS256 keys are provisioned with scripts/generate-keys.ts
# (writes keys/access.private.pem + keys/access.public.pem).
# Gitignored; provision via a secret manager in production.
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Firebase (native/FCM push tokens)
FIREBASE_SERVICE_ACCOUNT_JSON="{}"

# Expo Push (used when the app registers an Expo push token via expo-notifications).
# Optional — push works without it; set it to unlock higher Expo push rate limits.
EXPO_ACCESS_TOKEN=""

# Twilio
TWILIO_ACCOUNT_SID="your_account_sid"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Cashfree Payments
CF_APP_ID="your_cashfree_app_id"
CF_SECRET_KEY="your_cashfree_secret_key"
CF_ENV="SANDBOX"            # "PRODUCTION" or "SANDBOX" — MUST be PRODUCTION in production
CF_PAYOUT_APP_ID=""         # REQUIRED in production (app refuses to boot without it)
CF_PAYOUT_SECRET_KEY=""     # REQUIRED in production (app refuses to boot without it)
# 32-byte key (base64) for AES-256-GCM encryption-at-rest of chat messages.
# REQUIRED — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=""
API_URL="http://localhost:5000"

# Google Maps

PLATFORM_FEE_PERCENT="15"
LATE_CANCELLATION_FEE="50"
