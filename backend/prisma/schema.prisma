generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  WORKER
  ADMIN
  SUPER_ADMIN
}

enum BookingStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum BookingType {
  STANDARD
  URGENT
  GROUP
  REPEAT
  MAINTENANCE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum VerificationStatus {
  UNVERIFIED
  IN_PROGRESS // worker started the guided flow but hasn't submitted
  PENDING // submitted, under review (≡ PENDING_REVIEW)
  VERIFIED
  REJECTED
  RESUBMISSION_REQUIRED
  REVOKED
}

// Per-submission lifecycle. History is immutable — each resubmission is a new row.
enum VerificationSubmissionStatus {
  IN_PROGRESS
  PENDING_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
  REVOKED
}

enum VerificationDocumentSide {
  FRONT
  BACK
  SELFIE
}

enum ServiceCategory {
  PLUMBER
  ELECTRICIAN
  CARPENTER
  MAID
  DRIVER
  PAINTER
  AC_TECHNICIAN
  PEST_CONTROL
  GARDENER
  COOK
  TUTOR
  SECURITY_GUARD
  NURSE
  BABYSITTER
}

enum TransactionType {
  BOOKING_PAYMENT
  PLATFORM_COMMISSION
  WALLET_CREDIT
  WALLET_WITHDRAWAL
  REFERRAL_BONUS
  SUBSCRIPTION_PAYMENT
  REFUND
  LOYALTY_REDEMPTION
  SURGE_CHARGE
  GROUP_DISCOUNT
  PLUS_DISCOUNT
  PENALTY
  CANCELLATION_FEE
  CANCELLATION_REFUND
  URGENT_CANCELLATION_COMPENSATION
  CANCELLATION_RECOVERY
  PAYOUT
  DISPUTE_PAYOUT
  DISPUTE_REFUND
}

enum SubscriptionPlan {
  BASIC
  PLUS
  PRO
}

// Worker subscription plans are distinct from customer plans.
// FREE 15% / PRO 10% / ELITE 5% commission — commission applies to frozen base only.
enum WorkerPlan {
  FREE
  PRO
  ELITE
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum NegotiationStatus {
  OPEN
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DisputeDecision {
  PENDING
  CUSTOMER_REFUND
  WORKER_PAID
  SPLIT_50_50
  RE_DO_SERVICE
  CLOSED_NO_ACTION
}

enum CancellationFeeStatus {
  PENDING
  PAID
  WAIVED
  REFUNDED
}

enum JobStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

// Worker "guarantee/warranty" claim lifecycle (3-month warranty on eligible jobs).
enum GuaranteeClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Core User Models ───────────────────────────────────

model User {
  id               String    @id @default(cuid())
  phone            String    @unique
  email            String?   @unique
  name             String
  avatarUrl        String?
  role             UserRole  @default(CUSTOMER)
  secondaryRole    UserRole?
  isActive         Boolean   @default(true)
  isBanned         Boolean   @default(false)
  banReason        String?
  bannedAt         DateTime?
  bannedBy         String?
  banExpiresAt     DateTime?
  fcmToken         String?
  preferredLang    String    @default("en")
  referralCode     String?   @unique
  lastActiveAt     DateTime?
  loginCount       Int       @default(0)
  isPremium        Boolean   @default(false)
  premiumPlan      String    @default("BASIC")
  premiumExpiresAt DateTime?
  deviceInfo       Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customerProfile    CustomerProfile?
  workerProfile      WorkerProfile?
  bookingsAsCustomer Booking[]         @relation("CustomerBookings")
  bookingsAsWorker   Booking[]         @relation("WorkerBookings")
  reviewsGiven       Review[]          @relation("ReviewAuthor")
  reviewsReceived    Review[]          @relation("ReviewTarget")
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  addresses          Address[]
  messages           Message[]
  transactions       Transaction[]
  supportTickets     SupportTicket[]
  referralsGiven     ReferralEvent[]   @relation("ReferrerEvents")
  referralsReceived  ReferralEvent[]   @relation("ReferredEvents")
  subscription       UserSubscription?
  workerSubscription WorkerSubscription?
  auditLogs          AuditLog[]
  priceAlerts        PriceAlert[]
  maintenancePlans   MaintenancePlan[]
  savedWorkers       SavedWorker[]
  loginAttempts      LoginAttempt[]
  ticketMessages     TicketMessage[]
  mediaAssets        MediaAsset[]
  verificationSubmissions WorkerVerificationSubmission[]
  guaranteeClaims    GuaranteeClaim[]    @relation("GuaranteeClaimsAsCustomer")

  @@index([phone])
  @@index([role])
  @@index([referralCode])
  @@index([isBanned])
  @@index([createdAt])
}

model CustomerProfile {
  id            String               @id @default(cuid())
  userId        String               @unique
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalBookings Int                  @default(0)
  totalSpent    Float                @default(0)
  totalSaved    Float                @default(0)
  loyaltyPoints Int                  @default(0)
  loyaltyTier   LoyaltyTier          @default(BRONZE)
  walletBalance Float                @default(0)
  pendingCancellationFee Float        @default(0)
  createdAt     DateTime             @default(now())
  requests      CustomerJobRequest[]
  updatedAt     DateTime             @updatedAt
}

model CustomerJobRequest {
  id            String            @id @default(cuid())
  customerId    String
  customer      CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title         String
  description   String
  category      ServiceCategory
  issueId       String?
  scope         Json?
  recommendedPrice Float?
  // Service location is authoritative for pricing ; city/pincode are fallback metadata.
  addressId     String?
  address       Address?          @relation(fields: [addressId], references: [id])
  images        String[]          @default([])
  budget        Float?
  budgetType    String            @default("negotiable")
  pricingUnit   String            @default("FLAT") // FLAT, PER_HOUR
  recommendationExposed Boolean   @default(false) // price was platform-suggested
  finalAgreedAmount Float? // completed negotiation outcome
  city          String?
  pincode       String?
  scheduledDate DateTime?
  status        String            @default("OPEN")
  workerId      String?
  interests     RequestInterest[]
  offers        RequestOffer[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([customerId])
  @@index([category])
  @@index([status])
  @@index([city])
}

model RequestInterest {
  id              String             @id @default(cuid())
  requestId       String
  request         CustomerJobRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  workerId        String
  workerProfileId String
  workerName      String
  workerRating    Float              @default(0)
  workerCategory  ServiceCategory
  message         String?
  quoteAmount     Float? // worker's price quote
  quoteUnit       String             @default("FLAT") // FLAT, PER_HOUR
  quoteMessage    String?
  status          String             @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt       DateTime           @default(now())

  @@index([requestId])
  @@index([workerId])
  @@index([status])
}

// Bidirectional quote/counter negotiation on a request.
// Full negotiation history is market-behaviour evidence — never overwritten.
model RequestOffer {
  id          String             @id @default(cuid())
  requestId   String
  request     CustomerJobRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  interestId  String? // links to the worker's interest when offered by a worker
  offeredBy   String // "CUSTOMER" | "WORKER"
  amount      Float
  pricingUnit String             @default("FLAT") // FLAT, PER_HOUR
  message     String?
  status      String             @default("OPEN") // OPEN, ACCEPTED, REJECTED, SUPERSEDED
  createdAt   DateTime           @default(now())

  @@index([requestId])
  @@index([interestId])
}

model WorkerProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                 String?
  introVideoUrl       String?
  category            ServiceCategory
  subCategories       String[]           @default([])
  skills              String[]           @default([])
  experienceYears     Int                @default(0)
  hourlyRate          Float              @default(0)
  isAvailable         Boolean            @default(false)
  isOnline            Boolean            @default(false)
  isUrgentEligible    Boolean            @default(false)
  urgentEligibilityReason String?
  isGuaranteed        Boolean            @default(false)
  guaranteedSince     DateTime?
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  idProofType         String?
  idProofUrl          String?
  selfieUrl           String?
  verificationNote    String?
  verifiedAt          DateTime?
  isFeatured          Boolean            @default(false)
  featuredUntil       DateTime?
  rating              Float              @default(0.0)
  totalRatings        Int                @default(0)
  completedJobs       Int                @default(0)
  cancelledJobs       Int                @default(0)
  disputedJobs        Int                @default(0)
  totalEarned         Float              @default(0)
  thisMonthEarned     Float              @default(0)
  walletBalance       Float              @default(0)
  latitude            Float?
  longitude           Float?
  city                String?
  state               String?
  pincode             String?
  serviceRadiusKm     Int                @default(10)
  workPhotos          String[]           @default([])
  languages           String[]           @default(["en"])
  lastLocationAt      DateTime?
  // Lead quota — FREE workers get a monthly cap on express-interest leads;
  // PRO/ELITE are unlimited. Reset lazily at the start of each month.
  leadsUsedThisMonth  Int                @default(0)
  leadsQuotaResetAt   DateTime?
  isFrozen            Boolean            @default(false)
  isBanned            Boolean            @default(false)
  isPermanentlyBanned Boolean            @default(false)
  banReason           String?
  bannedAt            DateTime?
  appealCount         Int                @default(0)
  bankAccountNumber   String?
  bankIfsc            String?
  upiId               String?
  responseTimeMinutes Int                @default(0)
  acceptanceRate      Float              @default(0)
  streakDays          Int                @default(0)
  lastStreakAt        DateTime?
  weeklyEarningsGoal  Float?
  // Worker account health — escalation ladder driven by post-"On My Way"
  // cancellation rate. Status: ACTIVE / WARNED / RESTRICTED / SUSPENDED.
  healthStatus        String             @default("ACTIVE")
  cancellationRate    Float?
  reliabilityScore    Float?
  cancellationWarningCount Int           @default(0)
  healthUpdatedAt     DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  services        WorkerService[]
  jobs            WorkerJob[]
  withdrawals     WithdrawalRequest[]
  schedules       WorkerSchedule[]
  achievements    WorkerAchievement[]
  jobPhotos       JobPhoto[]
  locations       WorkerLocation[]
  guaranteeClaims GuaranteeClaim[]
  verificationSubmissions WorkerVerificationSubmission[]

  @@index([category])
  @@index([city])
  @@index([isAvailable, isOnline])
  @@index([verificationStatus])
  @@index([isGuaranteed])
  @@index([rating])
  @@index([isFeatured])
  @@index([isUrgentEligible])
}

// ─── Worker Identity Verification ──────────────────────────────
// Submission-level lifecycle. Each resubmission is a NEW row (version++).
// History is immutable; WorkerProfile.verificationStatus mirrors the latest.
model WorkerVerificationSubmission {
  id                    String                       @id @default(cuid())
  workerId              String
  worker                User                         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerProfileId       String
  workerProfile         WorkerProfile                @relation(fields: [workerProfileId], references: [id])
  status                VerificationSubmissionStatus @default(IN_PROGRESS)
  proofType             String
  verificationMethod    String                       @default("ADMIN_REVIEW") // future: PROVIDER
  // Consent — explicit, versioned, never pre-checked.
  consentGranted        Boolean                      @default(false)
  consentVersion        String?
  consentPolicyVersion  String?
  consentAt             DateTime?
  // Resubmission: which sides the worker must re-capture.
  resubmissionRequiredFor String[]                   @default([])
  // Review outcome
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedBy            String?
  decision              String? // APPROVE | REJECT | RESUBMISSION | REVOKE
  rejectionReason       String? // safe reason code
  rejectionNote         String?
  // Optional document expiry
  expiryDate            DateTime?
  version               Int                          @default(1)
  clientRequestId       String? // idempotency
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  docs                  WorkerVerificationDocument[]
  mediaAssets           MediaAsset[]

  @@unique([workerId, clientRequestId])
  @@index([workerId, status])
  @@index([status, createdAt])
  @@index([workerId, createdAt])
}

model WorkerVerificationDocument {
  id           String                    @id @default(cuid())
  submissionId String
  submission   WorkerVerificationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  workerId     String
  side         VerificationDocumentSide
  mediaId      String
  media        MediaAsset?               @relation(fields: [mediaId], references: [id], onDelete: NoAction)
  createdAt    DateTime                  @default(now())

  @@index([submissionId])
  @@index([workerId])
}

model WorkerService {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  name            String
  description     String
  basePrice       Float
  marketRate      Float?
  priceUnit       String        @default("per visit")
  imageUrl        String?
  isActive        Boolean       @default(true)
  bookingCount    Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model WorkerJob {
  id              String          @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile   @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        ServiceCategory
  price           Float
  priceUnit       String          @default("per visit")
  city            String?
  pincode         String?
  estimatedHours  Float?
  skills          String[]        @default([])
  status          JobStatus       @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([workerProfileId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

model WorkerSchedule {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date
  morningSlot     Boolean       @default(true)
  afternoonSlot   Boolean       @default(true)
  eveningSlot     Boolean       @default(true)
  isHoliday       Boolean       @default(false)
  note            String?
  createdAt       DateTime      @default(now())

  @@unique([workerProfileId, date])
  @@index([workerProfileId, date])
}

model WorkerLocation {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  bookingId       String?
  latitude        Float
  longitude       Float
  accuracy        Float?
  recordedAt      DateTime      @default(now())

  @@index([workerProfileId, recordedAt])
  @@index([bookingId])
}

model WorkerAchievement {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  badge           String
  earnedAt        DateTime      @default(now())
  notified        Boolean       @default(false)

  @@unique([workerProfileId, badge])
}

model JobPhoto {
  id               String        @id @default(cuid())
  workerProfileId  String
  workerProfile    WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  bookingId        String?
  booking          Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  beforeUrl        String
  afterUrl         String
  caption          String?
  customerApproved Boolean       @default(false)
  isPublic         Boolean       @default(false)
  createdAt        DateTime      @default(now())

  @@index([workerProfileId, isPublic])
  @@index([bookingId])
}

// ─── Address ─────────────────────────────────────────────

model Address {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String         @default("Home")
  line1         String
  line2         String?
  landmark      String?
  city          String
  state         String
  pincode       String
  latitude      Float
  longitude     Float
  isDefault     Boolean        @default(false)
  isDeleted     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  bookings      Booking[]
  requests      CustomerJobRequest[]

  @@index([userId])
}

// ─── Booking Models ──────────────────────────────────────

model Booking {
  id                 String               @id @default(cuid())
  bookingNumber      String               @unique
  type               BookingType          @default(STANDARD)
  customerId         String
  customer           User                 @relation("CustomerBookings", fields: [customerId], references: [id])
  workerId           String
  worker             User                 @relation("WorkerBookings", fields: [workerId], references: [id])
  addressId          String
  address            Address              @relation(fields: [addressId], references: [id])
  maintenancePlanId  String?
  maintenancePlan    MaintenancePlan?     @relation(fields: [maintenancePlanId], references: [id])
  serviceCategory    ServiceCategory
  serviceName        String
  description        String
  issueId            String?
  scope              Json?
  recommendedPrice   Float?
  scheduledAt        DateTime
  estimatedDuration  Int
  status             BookingStatus        @default(PENDING)
  paymentStatus      PaymentStatus        @default(PENDING)
  isSurge            Boolean              @default(false)
  surgeMultiplier    Float                @default(1.0)
  baseAmount         Float
  urgencyPremium     Float                @default(0)
  customerBoostTotal Float                @default(0)
  acceptedOffer      Float?
  pricingUnit        String               @default("FLAT")
  pricingSnapshot    Json?
  negotiatedAmount   Float?
  
  // ─── PAYMENT CALCULATION FIELDS ───────────────────────
  // These fields are LOCKED at booking acceptance and store the calculated payment amounts.
  // They are never retroactively changed except during scope changes where the locked
  // platformFeePercent is preserved. All these fields MUST be non-null and populated at booking creation.
  
  // Commission percentage locked at acceptance (15=FREE, 10=PRO, 5=ELITE, 0=URGENT)
  // LOCKED: Never changes retroactively, even if worker upgrades plan
  platformFeePercent Float                @default(0)
  // Commission amount in rupees calculated as: baseAmount * platformFeePercent / 100
  // LOCKED: Frozen at booking acceptance, serves as audit trail for what commission was applied
  platformFee        Float                @default(0)
  // What worker receives after platform commission: baseAmount - platformFee
  // LOCKED: Represents guaranteed worker payout for this booking
  workerEarnings     Float                @default(0)
  // Applied commission rate label for audit purposes (e.g. "WORKER_PLAN_FREE", "WORKER_PLAN_PRO", "WORKER_PLAN_ELITE", "URGENT_ZERO")
  // Explains which tier or rule was used to calculate platformFeePercent
  appliedCommissionRate String?
  
  // Subscription discount from customer's PLUS (10%) or PRO (20%) plan, deducted from what customer pays
  // Non-zero only for STANDARD/EMERGENCY bookings when customer has active subscription
  subscriptionDiscount Float               @default(0)
  // Pending cancellation fee charged to customer if applicable (e.g., from previous cancellation)
  // Non-zero only when customer has outstanding cancel fee debt
  pendingCancellationFee Float             @default(0)
  
  // For URGENT bookings only: premium amount on top of baseAmount due to urgency
  // Calculated as: (baseAmount * urgencySurgeMultiplier) - baseAmount
  urgencyPremiumAmount Float?
  // For URGENT bookings only: the multiplier used (e.g. 1.5x, 2x, 2.5x for surge pricing)
  // LOCKED: Represents agreed surge multiple at time of booking
  urgencySurgeMultiplier Float?
  // For URGENT bookings only: breakdown of worker earnings as JSON with keys:
  // { baseEarnings, urgencyEarnings, customerBoostAmount } for ledger audit trail
  urgencyBreakdown   Json?
  
  // Total amount what customer pays: baseAmount - subscriptionDiscount + pendingCancellationFee
  // For URGENT bookings, this equals workerEarnings (no commission deducted from customer payment)
  totalAmount        Float                @default(0)
  // When payment calculation was created (immutable timestamp for audit trail)
  calculatedAt       DateTime             @default(now())
  // When payment calculation was last recalculated (e.g., during scope change; null if never recalculated)
  lastRecalculatedAt DateTime?
  
  // ─── DEPRECATED FIELDS (will be removed after migration) ───────────
  plusDiscount       Float                @default(0)
  // ─────────────────────────────────────────────────────────────────
  
  marketRate         Float?
  customerSaved      Float                @default(0)
  // Labour/material/visit-fee separation — never teach labour pricing
  // using material costs. Optional breakdown shown separately on the invoice.
  materialCost       Float?
  visitFee           Float?
  tip                Float?
  arrivalOtp         String?
  workerLat          Float?
  workerLng          Float?
  workerEta          Int?
  acceptedAt         DateTime?
  onTheWayAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancelReason       String?
  cancelRequestBy      String?
  cancelRequestReason  String?
  cancelRequestStatus  String?
  cancelRequestAt      DateTime?
  customerNotes      String?
  workerNotes        String?
  paymentOrderId    String?
  paymentRefId  String?
  paymentSignature  String?
  safetyAlertSentAt  DateTime?
  safetyConfirmedAt  DateTime?
  travelProtectionEligibleAt DateTime?
  cancellationCharge Float                @default(0)
  workerCompensation Float                @default(0)
  // Warranty / guarantee: when eligible, the completed booking carries a
  // warranty window (default 3 months, admin-configurable) during which the
  // customer may raise a GuaranteeClaim.
  warrantyEligible    Boolean             @default(false)
  warrantyExpiresAt   DateTime?
  review             Review?
  chat               Chat?
  negotiation        Negotiation?
  dispute            Dispute?
  cancellation       CancellationRecord?
  scopeChanges       ScopeChangeRequest[]
  safetyChecks       BookingSafetyCheck[]
  guaranteeClaims    GuaranteeClaim[]
  jobPhotos          JobPhoto[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([customerId])
  @@index([workerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([type])
  @@index([scheduledAt])
  @@index([createdAt])
  @@index([warrantyExpiresAt])
}

model Negotiation {
  id         String             @id @default(cuid())
  bookingId  String             @unique
  booking    Booking            @relation(fields: [bookingId], references: [id])
  status     NegotiationStatus  @default(OPEN)
  rounds     Int                @default(0)
  finalPrice Float?
  expiresAt  DateTime
  offers     NegotiationOffer[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model NegotiationOffer {
  id            String      @id @default(cuid())
  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])
  offeredBy     String
  amount        Float
  message       String?
  respondedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@index([negotiationId])
}

model BookingSafetyCheck {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id])
  sentAt      DateTime  @default(now())
  respondedAt DateTime?
  response    String?
  escalated   Boolean   @default(false)

  @@index([bookingId])
}

// ─── Reviews & Disputes ──────────────────────────────────

model Review {
  id                 String   @id @default(cuid())
  bookingId          String   @unique
  booking            Booking  @relation(fields: [bookingId], references: [id])
  authorId           String
  author             User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId           String
  target             User     @relation("ReviewTarget", fields: [targetId], references: [id])
  rating             Int
  comment            String?
  photos             String[] @default([])
  hasPhotos          Boolean  @default(false)
  isVerifiedPurchase Boolean  @default(true)
  helpfulCount       Int      @default(0)
  isPublic           Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@index([targetId, rating])
  @@index([createdAt])
}

model Dispute {
  id               String          @id @default(cuid())
  bookingId        String          @unique
  booking          Booking         @relation(fields: [bookingId], references: [id])
  raisedBy         String
  reason           String
  customerEvidence String[]        @default([])
  workerEvidence   String[]        @default([])
  decision         DisputeDecision @default(PENDING)
  adminNotes       String?
  refundAmount     Float?
  resolvedAt       DateTime?
  resolvedBy       String?
  timeline         Json?
