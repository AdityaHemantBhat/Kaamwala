model Transaction {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  bookingId     String?
  type          TransactionType
  amount        Float
  balanceBefore Float?
  balanceAfter  Float?
  description   String
  status        String          @default("completed")
  reference     String?
  meta          Json?
  // Calculation details: stores payment calculation metadata
  // For WALLET_CREDIT and PLATFORM_COMMISSION, stores baseAmount, platformFeePercent, platformFee
  // For URGENT, stores urgencyBreakdown with baseEarnings, urgencyEarnings, customerBoost
  // Used for audit trail and ledger reconciliation
  calculationDetails Json?
  // Idempotency : deterministic key so network retries/double taps
  // cannot duplicate money/actions. e.g. `bookingId:WALLET_CREDIT`.
  idempotencyKey String?         @unique
  createdAt     DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([type])
  // Hot path: the idempotency guard in bookingService.processPayout /
  // cancellation lookups filter on bookingId (+ type). Avoids a table scan on
  // every completion / payout.
  @@index([bookingId, type])
  // Wallet-topup dedup lookup: findFirst({ where: { reference: orderId } }).
  @@index([reference])
}

model WithdrawalRequest {
  id              String        @id @default(cuid())
  workerProfileId String
