// ─── Issue Taxonomy (What's Happening?) ───────────────────

enum IssueLifecycle {
  CANDIDATE
  ESTABLISHED
  DECLINING
  ARCHIVED
}

model Issue {
  id            String         @id @default(cuid())
  category      ServiceCategory
  canonicalId   String // e.g. "TAP_INSTALLATION" — stable identity, not display label
  label         String // display label, localizable later
  description   String?
  lifecycle     IssueLifecycle @default(ESTABLISHED)
  // Optional structured scope config: JSON e.g. {"quantity": {"label":"Number of taps","min":1,"max":10}}
  scopeConfig   Json?
  sortOrder     Int            @default(0)
  usageCount    Int            @default(0)
  uniqueUsers   Int            @default(0)
  completedCount Int           @default(0)
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  aliases       IssueAlias[]

  @@unique([category, canonicalId])
  @@index([category, lifecycle])
}

model IssueAlias {
  id        String    @id @default(cuid())
  issueId   String
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  alias     String // normalized phrase
  lang      String    @default("en")
  createdAt DateTime  @default(now())

  @@unique([issueId, alias])
  @@index([alias])
}

model IssueCandidate {
  id            String         @id @default(cuid())
  category      ServiceCategory
  phrase        String // normalized discovered phrase
  lifecycle     IssueLifecycle @default(CANDIDATE)
  occurrenceCount Int          @default(0)
  uniqueUsers    Int           @default(0)
  riskScore      Float         @default(0)
  lastSeenAt     DateTime?
  linkedIssueId  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  users          IssueCandidateUser[]

  @@unique([category, phrase])
  @@index([category, lifecycle])
}

// Distinct-user tracking for promotion — one user spamming must not
// inflate uniqueUsers. Each (candidate, user) row exists once.
model IssueCandidateUser {
  id          String         @id @default(cuid())
  candidateId String
  candidate   IssueCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime       @default(now())

  @@unique([candidateId, userId])
  @@index([userId])
}

