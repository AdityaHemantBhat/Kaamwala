# Normalise all text files to LF in the repo; Windows checks out as CRLF
* text=auto eol=lf

# Binary assets — never mangle line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.jks  binary
*.p8   binary
*.p12  binary
*.mobileprovision binary

# Source files — always LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
*.env.example text eol=lf
